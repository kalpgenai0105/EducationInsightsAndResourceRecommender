# ============================================================
# Education Insights & Resource Recommender — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

# --- Google Cloud project settings ----------------------------
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- BigQuery -------------------------------------------------
BIGQUERY_DATASET=education_insights
# Optional: override the default project for BQ queries
# BIGQUERY_PROJECT=your-gcp-project-id

# --- Authentication -------------------------------------------
# Path to a service-account JSON key (local dev only).
# In production on GCP, use Workload Identity instead.
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json

# --- Vertex AI Agent Engine -----------------------------------
# Set after running deployment/deploy_agents.py
# AGENT_ENGINE_RESOURCE_NAME=projects/.../locations/.../reasoningEngines/...

# --- Gemini model override (optional) -------------------------
# Default is gemini-2.0-flash; override here for testing.
# AGENT_MODEL=gemini-2.0-flash
